# ─────────────────────────────────────────────────────────────────────────────
# Stripe Checkout — server environment variables
# ─────────────────────────────────────────────────────────────────────────────
#
# STRIPE_SECRET_KEY
#   1. Go to https://dashboard.stripe.com/apikeys
#   2. Make sure Test Mode is ON (toggle in the top-left of the dashboard)
#   3. Copy "Secret key" (starts with sk_test_…) → paste below
#
# STRIPE_WEBHOOK_SECRET
#   LOCAL DEVELOPMENT — obtained from the Stripe CLI:
#     stripe listen --forward-to localhost:3001/api/webhook
#   The CLI prints a "whsec_…" signing secret at startup — paste it below.
#   This secret is LOCAL ONLY and rotates each time you restart `stripe listen`.
#
#   PRODUCTION — obtained from the Stripe Dashboard:
#     Dashboard → Developers → Webhooks → Add endpoint
#     → set your endpoint URL → copy the signing secret shown there
#   That secret is permanent and belongs in your production server's env vars.
#
# RESEND_API_KEY
#   Used to send order confirmation emails after each successful payment.
#
#   1. Sign up (free) at https://resend.com
#   2. Go to API Keys → Create API Key
#   3. Copy the re_… value and paste it below
#
#   TEST / SANDBOX:
#     With the sandbox sender (onboarding@resend.dev, set in server/email.js),
#     Resend delivers ONLY to the email address that owns your Resend account.
#     This is intentional — use it to verify the integration before going live.
#
#   PRODUCTION (custom sender):
#     1. Go to Resend → Domains → Add Domain → verify DNS records
#     2. In server/email.js, replace FROM_ADDRESS with "orders@yourdomain.com"
#     3. With a verified domain, Resend delivers to any recipient email
#
#   If this variable is not set, the webhook still works — only the email
#   send is skipped with a console warning.
#
# ⚠️  NEVER commit the real .env file to git — it's already in .gitignore
# ⚠️  TEST keys (sk_test_…, whsec_… from CLI) are safe for local development
# ⚠️  LIVE keys (sk_live_…) make real charges — a deliberate step before launch
# ─────────────────────────────────────────────────────────────────────────────

STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE
RESEND_API_KEY=re_YOUR_RESEND_API_KEY_HERE
EMAIL_FROM="Air Jordan Store <hello@amoridev.com>"
PORT=3001

# RESEND_AUDIENCE_ID
#   Backs the footer newsletter signup. Subscribers are always written to the
#   local SQLite table first; this syncs them to a real Resend audience so the
#   list survives a redeploy (data.db is ephemeral on Render).
#
#   1. Go to https://resend.com/audiences → Create Audience
#   2. Copy the audience ID and paste it below
#
#   If this is unset, signup still works — the Resend step is skipped with a
#   warning and the subscriber is kept locally.

RESEND_AUDIENCE_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Cloudinary — product image uploads from the admin panel
# ─────────────────────────────────────────────────────────────────────────────
#   1. Sign up (free) at https://cloudinary.com
#   2. Dashboard → Product Environment Credentials → copy Cloud name, API Key,
#      API Secret into the three variables below.
#
#   The browser NEVER sees the API secret. GET /api/admin/upload-signature (behind
#   admin Basic Auth) mints a short-lived SHA-1 signature, and the browser uploads
#   the image straight to Cloudinary with it — the image never passes through this
#   server, which is what keeps it under express.json()'s 100kb body limit.
#
#   If these are unset the endpoint returns 503 and the admin form falls back to
#   pasting an image URL by hand, so the app still works without them.
#
#   Hardening: in Cloudinary → Settings → Upload, cap the max file size and
#   restrict allowed formats as defence in depth.
# ─────────────────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Admin Dashboard
#
# ⚠️  NEVER commit a real username or password hash here. This file is TRACKED
#     and public. A bcrypt hash is offline-crackable: a weak password behind one
#     is equivalent to publishing the password itself. Both values below are
#     placeholders — put the real ones only in server/.env (gitignored) and in
#     your host's environment variables.
#
# To generate a hash for your password, run:
#   cd server && node generate-hash.js <your_password>
# Then paste the output into server/.env (NOT here):
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD_HASH="$2b$10$REPLACE_WITH_YOUR_OWN_HASH_SEE_README"
