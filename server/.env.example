# Copy this file to server/.env and fill in the values. Never commit the real .env.

# Stripe (use test keys while developing)
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE
# Local: run `stripe listen --forward-to localhost:3001/api/webhook` and paste the whsec_ value.
# Production: Stripe Dashboard > Developers > Webhooks > your endpoint.
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# Order confirmation emails and newsletter (https://resend.com)
RESEND_API_KEY=re_YOUR_RESEND_API_KEY_HERE
EMAIL_FROM="Sneakers Store <hello@amoridev.com>"
# Optional: syncs newsletter signups to a Resend audience so they survive redeploys.
RESEND_AUDIENCE_ID=

# Cloudinary image uploads from the admin panel (optional, the form accepts image URLs without it)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Admin dashboard. Generate the hash with: cd server && node generate-hash.js <password>
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD_HASH="$2b$10$REPLACE_WITH_YOUR_OWN_HASH"

# Public URL of the storefront without a trailing slash. Required in production:
# Stripe redirects customers here after payment and CORS allows this origin.
FRONTEND_URL=

# Optional
PORT=3001
# Path of the SQLite file, defaults to server/data.db
DB_PATH=
# Set to "production" on the host
NODE_ENV=
